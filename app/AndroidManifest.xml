<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.antidoomscroll"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Target 34: a sideloaded app has no Play target requirement, and 35+ would force
         edge-to-edge and predictive-back changes this small UI does not need. -->
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- No INTERNET permission: all data stays on the device (R-13). -->
    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".OnboardingActivity" android:exported="false" android:label="@string/app_name" />
        <activity android:name=".SettingsActivity" android:exported="false" android:label="Settings"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".TodayActivity" android:exported="false" android:label="Today"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".GuardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_config" />
        </service>
    </application>
</manifest>
